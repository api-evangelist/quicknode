{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuickNode IPFS REST Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quicknode.com/ipfs/rest/v1/account/usage"
          },
          "docs": "Returns current bandwidth and storage usage for the account."
        }
      ]
    }
  ],
  "bundled": true
}