{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuickNode IPFS REST Account Batch API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk write keys",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.quicknode.com/ipfs/rest/databases/:database/batch",
            "params": [
              {
                "name": "database",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk write keys"
        }
      ]
    }
  ],
  "bundled": true
}