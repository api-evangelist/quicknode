{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuickNode IPFS REST Account Database API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Database",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quicknode.com/ipfs/rest/databases"
          },
          "docs": "List databases"
        },
        {
          "info": {
            "name": "Create a database",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.quicknode.com/ipfs/rest/databases",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a database"
        },
        {
          "info": {
            "name": "Delete a database",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.quicknode.com/ipfs/rest/databases/:database",
            "params": [
              {
                "name": "database",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a database"
        }
      ]
    }
  ],
  "bundled": true
}