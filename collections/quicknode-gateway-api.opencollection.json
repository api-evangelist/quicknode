{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuickNode IPFS REST Account Gateway API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gateway",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List gateways",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.quicknode.com/ipfs/rest/v1/gateways"
          },
          "docs": "List gateways"
        },
        {
          "info": {
            "name": "Create gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.quicknode.com/ipfs/rest/v1/gateways",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create gateway"
        }
      ]
    }
  ],
  "bundled": true
}